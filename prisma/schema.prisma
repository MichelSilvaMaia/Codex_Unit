generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum RoleScope {
  PLATFORM
  TENANT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditScope {
  PLATFORM
  TENANT
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerAddressType {
  BILLING
  OPERATIONAL
  DELIVERY
  OTHER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum ResourceOperationalStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  UNAVAILABLE
  RETIRED
}

enum ReservationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
  READY_FOR_PICKUP
  RELEASED
  CANCELLED
}

enum PickupStatus {
  IN_PROGRESS
  COMPLETED
  REFUSED
  CANCELLED
}

enum PickupItemStatus {
  PENDING
  RELEASED
  REFUSED
}

enum ResourceCondition {
  OK
  DAMAGED
  DIVERGENT
  OTHER
}

enum PickupRefusalReason {
  DAMAGE
  RESOURCE_MISMATCH
  DOCUMENT_MISMATCH
  RECIPIENT_MISMATCH
  RESERVATION_INVALID
  OTHER
}

enum EvidenceType {
  DAMAGE
  DIVERGENCE
  RESOURCE_IDENTIFICATION
  OUTPUT_CONDITION
}

enum CustodyEventType {
  RELEASED_TO_RECIPIENT
}

enum ReservationDecision {
  APPROVED
  REJECTED
}

model User {
  id                       String                     @id @default(uuid()) @db.Uuid
  name                     String?
  email                    String                     @unique
  emailVerified            DateTime?
  image                    String?
  status                   UserStatus                 @default(INVITED)
  memberships              TenantMembership[]
  auditLogs                AuditLog[]                 @relation("AuditActor")
  accounts                 Account[]
  credential               PasswordCredential?
  passwordResetTokens      PasswordResetToken[]
  sentInvitations          TenantInvitation[]         @relation("InvitationSender")
  createdReservations      Reservation[]              @relation("ReservationCreator")
  cancelledReservations    Reservation[]              @relation("ReservationCanceller")
  reservationStatusHistory ReservationStatusHistory[] @relation("ReservationStatusActor")
  submittedReservations    Reservation[]              @relation("ReservationSubmitter")
  approvedReservations     Reservation[]              @relation("ReservationApprover")
  rejectedReservations     Reservation[]              @relation("ReservationRejecter")
  reservationDecisions     ReservationApproval[]      @relation("ReservationDecisionActor")
  processedPickups         ReservationPickup[]        @relation("PickupProcessor")
  checkedPickupItems       ReservationPickupItem[]    @relation("PickupItemChecker")
  uploadedEvidence         OperationalEvidence[]      @relation("EvidenceUploader")
  custodyEvents            ResourceCustodyEvent[]     @relation("CustodyActor")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
}

model Tenant {
  id                       String                     @id @default(uuid()) @db.Uuid
  legalName                String
  tradeName                String
  slug                     String                     @unique
  status                   TenantStatus               @default(ACTIVE)
  memberships              TenantMembership[]
  auditLogs                AuditLog[]
  roles                    Role[]
  invitations              TenantInvitation[]
  units                    Unit[]
  customers                Customer[]
  customerContacts         CustomerContact[]
  customerAddresses        CustomerAddress[]
  contracts                Contract[]
  contractUnits            ContractUnit[]
  resourceCategories       ResourceCategory[]
  resources                Resource[]
  reservations             Reservation[]
  reservationItems         ReservationItem[]
  reservationStatusHistory ReservationStatusHistory[]
  reservationApprovals     ReservationApproval[]
  pickups                  ReservationPickup[]
  pickupItems              ReservationPickupItem[]
  operationalEvidence      OperationalEvidence[]
  custodyEvents            ResourceCustodyEvent[]
  timeZone                 String                     @default("America/Sao_Paulo")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
}

model Unit {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  name         String
  code         String
  status       RecordStatus   @default(ACTIVE)
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String         @default("BR")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contracts    ContractUnit[]
  resources    Resource[]
  reservations Reservation[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model Customer {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  type               CustomerType
  legalName          String
  tradeName          String?
  document           String?
  normalizedDocument String?
  status             RecordStatus      @default(ACTIVE)
  email              String?
  phone              String?
  notes              String?
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contacts           CustomerContact[]
  addresses          CustomerAddress[]
  contracts          Contract[]
  reservations       Reservation[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, normalizedDocument])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, legalName])
}

model CustomerContact {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  customerId String       @db.Uuid
  name       String
  title      String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean      @default(false)
  status     RecordStatus @default(ACTIVE)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer   Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId, customerId, status])
}

model CustomerAddress {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  customerId   String              @db.Uuid
  type         CustomerAddressType
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String              @default("BR")
  latitude     Decimal?            @db.Decimal(10, 7)
  longitude    Decimal?            @db.Decimal(10, 7)
  isPrimary    Boolean             @default(false)
  status       RecordStatus        @default(ACTIVE)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Customer            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId, customerId, status])
}

model Contract {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  customerId   String         @db.Uuid
  code         String
  title        String
  description  String?
  startDate    DateTime       @db.Date
  endDate      DateTime?      @db.Date
  status       ContractStatus @default(DRAFT)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  units        ContractUnit[]
  reservations Reservation[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model ContractUnit {
  tenantId   String   @db.Uuid
  contractId String   @db.Uuid
  unitId     String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract   Contract @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Cascade)
  unit       Unit     @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([contractId, unitId])
  @@index([tenantId, unitId])
}

model ResourceCategory {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  name        String
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resources   Resource[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model Resource {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @db.Uuid
  unitId            String                    @db.Uuid
  categoryId        String                    @db.Uuid
  code              String
  name              String
  description       String?
  serialNumber      String?
  status            RecordStatus              @default(ACTIVE)
  operationalStatus ResourceOperationalStatus @default(AVAILABLE)
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit              Unit                      @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)
  category          ResourceCategory          @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  reservationItems  ReservationItem[]
  pickupItems       ReservationPickupItem[]
  custodyEvents     ResourceCustodyEvent[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status, operationalStatus])
  @@index([tenantId, unitId])
  @@index([tenantId, categoryId])
}

model Reservation {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @db.Uuid
  customerId         String                     @db.Uuid
  contractId         String?                    @db.Uuid
  unitId             String                     @db.Uuid
  code               String
  title              String
  description        String?
  startAt            DateTime                   @db.Timestamptz(3)
  endAt              DateTime                   @db.Timestamptz(3)
  status             ReservationStatus          @default(DRAFT)
  createdByUserId    String                     @db.Uuid
  isUrgent           Boolean                    @default(false)
  urgentReason       String?
  submittedAt        DateTime?                  @db.Timestamptz(3)
  submittedByUserId  String?                    @db.Uuid
  approvedAt         DateTime?                  @db.Timestamptz(3)
  approvedByUserId   String?                    @db.Uuid
  rejectedAt         DateTime?                  @db.Timestamptz(3)
  rejectedByUserId   String?                    @db.Uuid
  rejectionReason    String?
  cancelledAt        DateTime?                  @db.Timestamptz(3)
  cancelledByUserId  String?                    @db.Uuid
  cancellationReason String?
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer           Customer                   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  contract           Contract?                  @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict)
  unit               Unit                       @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)
  createdBy          User                       @relation("ReservationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy        User?                      @relation("ReservationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  approvedBy         User?                      @relation("ReservationApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  rejectedBy         User?                      @relation("ReservationRejecter", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  cancelledBy        User?                      @relation("ReservationCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  items              ReservationItem[]
  statusHistory      ReservationStatusHistory[]
  approvals          ReservationApproval[]
  pickups            ReservationPickup[]
  custodyEvents      ResourceCustodyEvent[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, startAt])
  @@index([tenantId, endAt])
  @@index([tenantId, customerId])
  @@index([tenantId, contractId])
  @@index([tenantId, unitId])
}

model ReservationApproval {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  reservationId   String              @db.Uuid
  decision        ReservationDecision
  decidedByUserId String              @db.Uuid
  reason          String?
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation     Reservation         @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Cascade)
  decidedBy       User                @relation("ReservationDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now())

  @@index([tenantId, reservationId, createdAt])
  @@index([decidedByUserId, createdAt])
}

model ReservationItem {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @db.Uuid
  reservationId String                  @db.Uuid
  resourceId    String                  @db.Uuid
  startAt       DateTime                @db.Timestamptz(3)
  endAt         DateTime                @db.Timestamptz(3)
  status        ReservationStatus
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation   Reservation             @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Cascade)
  resource      Resource                @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Restrict)
  pickupItems   ReservationPickupItem[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([reservationId, resourceId])
  @@index([tenantId, reservationId])
  @@index([tenantId, resourceId, startAt, endAt])
}

model ReservationPickup {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @db.Uuid
  reservationId     String                  @db.Uuid
  status            PickupStatus            @default(IN_PROGRESS)
  startedAt         DateTime                @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?               @db.Timestamptz(3)
  refusedAt         DateTime?               @db.Timestamptz(3)
  processedByUserId String                  @db.Uuid
  recipientName     String
  recipientDocument String?
  recipientPhone    String?
  vehiclePlate      String?
  notes             String?
  refusalReasonCode PickupRefusalReason?
  refusalNotes      String?
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation       Reservation             @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  processedBy       User                    @relation("PickupProcessor", fields: [processedByUserId], references: [id], onDelete: Restrict)
  items             ReservationPickupItem[]
  evidence          OperationalEvidence[]
  custodyEvents     ResourceCustodyEvent[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, reservationId, createdAt])
}

model ReservationPickupItem {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  pickupId          String                @db.Uuid
  reservationItemId String                @db.Uuid
  resourceId        String                @db.Uuid
  status            PickupItemStatus      @default(PENDING)
  condition         ResourceCondition     @default(OK)
  notes             String?
  checkedAt         DateTime?             @db.Timestamptz(3)
  checkedByUserId   String?               @db.Uuid
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pickup            ReservationPickup     @relation(fields: [tenantId, pickupId], references: [tenantId, id], onDelete: Cascade)
  reservationItem   ReservationItem       @relation(fields: [reservationItemId], references: [id], onDelete: Restrict)
  resource          Resource              @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Restrict)
  checkedBy         User?                 @relation("PickupItemChecker", fields: [checkedByUserId], references: [id], onDelete: Restrict)
  evidence          OperationalEvidence[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([pickupId, reservationItemId])
  @@unique([tenantId, id])
  @@index([tenantId, pickupId])
  @@index([tenantId, resourceId])
}

model OperationalEvidence {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @db.Uuid
  pickupId         String                 @db.Uuid
  pickupItemId     String?                @db.Uuid
  type             EvidenceType
  storageKey       String                 @unique
  mimeType         String
  size             Int
  checksum         String
  uploadedByUserId String                 @db.Uuid
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pickup           ReservationPickup      @relation(fields: [tenantId, pickupId], references: [tenantId, id], onDelete: Cascade)
  pickupItem       ReservationPickupItem? @relation(fields: [tenantId, pickupItemId], references: [tenantId, id], onDelete: Cascade)
  uploadedBy       User                   @relation("EvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now())

  @@index([tenantId, pickupId, createdAt])
}

model ResourceCustodyEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  resourceId    String            @db.Uuid
  reservationId String            @db.Uuid
  pickupId      String            @db.Uuid
  type          CustodyEventType
  fromParty     String
  toParty       String
  actorUserId   String            @db.Uuid
  occurredAt    DateTime          @default(now()) @db.Timestamptz(3)
  metadata      Json?
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resource      Resource          @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Restrict)
  reservation   Reservation       @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  pickup        ReservationPickup @relation(fields: [tenantId, pickupId], references: [tenantId, id], onDelete: Restrict)
  actor         User              @relation("CustodyActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, resourceId, occurredAt])
  @@index([tenantId, reservationId])
}

model ReservationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  reservationId String             @db.Uuid
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  actorUserId   String             @db.Uuid
  reason        String?
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservation   Reservation        @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Cascade)
  actor         User               @relation("ReservationStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())

  @@index([tenantId, reservationId, createdAt])
  @@index([actorUserId, createdAt])
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  tenantId  String           @db.Uuid
  status    MembershipStatus @default(INVITED)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles     MembershipRole[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  scope       AuditScope @default(TENANT)
  tenantId    String?    @db.Uuid
  actorUserId String?    @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId, createdAt])
}

model PasswordCredential {
  userId       String   @id @db.Uuid
  passwordHash String
  changedAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String?          @db.Uuid
  scope       RoleScope        @default(TENANT)
  name        String
  code        String
  description String?
  isSystem    Boolean          @default(false)
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, scope])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  membershipId String           @db.Uuid
  roleId       String           @db.Uuid
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@id([membershipId, roleId])
  @@index([roleId])
}

model TenantInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  email           String
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String           @db.Uuid
  acceptedAt      DateTime?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())

  @@index([tenantId, email, status])
  @@index([expiresAt, status])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}
