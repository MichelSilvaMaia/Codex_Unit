DATABASE_URL="postgresql://codex_unit:codex_unit@localhost:5432/codex_unit?schema=public"
AUTH_SECRET="replace-with-at-least-32-characters"
OTP_HMAC_SECRET="replace-with-a-separate-32-character-secret"
OTP_PROVIDER_MODE="development"
OTP_PROVIDER_TIMEOUT_MS="8000"

# Zenvia API v2. API secret is optional and only used for signed-token authentication.
ZENVIA_API_TOKEN=""
ZENVIA_API_SECRET=""
ZENVIA_WHATSAPP_FROM=""
ZENVIA_WHATSAPP_OTP_TEMPLATE_ID=""
ZENVIA_WHATSAPP_TEMPLATE_LOCALE="pt_BR"
ZENVIA_SMS_FROM=""
# Configure this same value as X-Webhook-Token in the Zenvia webhook headers.
ZENVIA_WEBHOOK_TOKEN=""

# Resend production email and Svix webhook signing secret.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME="Codex Unit"
RESEND_WEBHOOK_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
LOG_LEVEL="info"

# OAuth providers are optional. Define both values for each provider you enable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_TENANT_ID="common"

# Development-only bootstrap. No default password is stored in the repository.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD=""
